# Insight Forge - Environment Configuration
# Copy to .env and fill in values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_URL=http://localhost:8001

# LLM Provider: openai | qwen
LLM_PROVIDER=openai

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Qwen (when LLM_PROVIDER=qwen)
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Template path (relative to project root)
TEMPLATE_PPTX_PATH=example_files/example slides.pptx

# Tavily Web Search (for in-app internet search feature)
TAVILY_API_KEY=your-tavily-api-key

# Voice/ASR (DashScope Qwen realtime - for voice input in chatbox)
# Uses QWEN_API_KEY if DASHSCOPE_API_KEY not set
DASHSCOPE_API_KEY=your-dashscope-api-key

# Microsoft Entra ID (optional API JWT protection)
# Stub values until app registration exists; set AUTH_ENABLED=true when ready.
AUTH_ENABLED=true
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Comma-separated if the API accepts multiple audience values
ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000

# Frontend (Vite reads repo-root .env via insight-forge-web/vite.config envDir)
VITE_ENTRA_AUTH_ENABLED=true
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
