# Insight Forge - Environment Configuration
# Copy to .env and fill in values

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8001
BACKEND_URL=http://localhost:8001

# Frontend
FRONTEND_PORT=8501

# LLM Provider: openai | qwen
LLM_PROVIDER=openai

# Retriever toggle:
# true  -> use BM25 retriever chunks (current flow)
# false -> send full cleaned markdown content to LLM
USE_RETRIEVER=true

# Agentic evidence pipeline (MVP defaults)
MAX_CANDIDATES=150
MAX_FACET_NEW_PER_REQUEST=120
FACET_BATCH_SIZE=12
MAX_CHUNKS_AGENT_READ=20
MAX_TO_COMPRESS=20
MAX_ITERATIONS_EXPAND=1
MAX_AGENT_STEPS=3

# OpenAI (when LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# Qwen (when LLM_PROVIDER=qwen)
QWEN_API_KEY=your-qwen-api-key
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# Template path (relative to project root)
TEMPLATE_PPTX_PATH=example_files/example slides.pptx

# Tavily Web Search (for in-app internet search feature)
TAVILY_API_KEY=your-tavily-api-key

# Voice/ASR (DashScope Qwen realtime - for voice input in chatbox)
# Uses QWEN_API_KEY if DASHSCOPE_API_KEY not set
DASHSCOPE_API_KEY=your-dashscope-api-key
